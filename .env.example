# Copy this file to .env and fill in your own values.
# See README.md "Quick Start" for how to obtain each of these.

# --- Server ---
PORT=3458
# Shared secret you put in your MCP client's URL as ?token=...
# NOTE: the server currently does not verify this itself (see server.py
# comment near MCP_TOKEN) - treat it as a placeholder / reverse-proxy hook
# unless you add your own check. Leave unset to get a random one printed
# at startup (it will change every restart, so set it explicitly for
# anything long-lived).
MCP_TOKEN=

# --- Apple Developer / MusicKit ---
# Your Apple Developer Team ID (10 chars, found in the Developer portal
# under Membership details).
APPLE_TEAM_ID=ABCDE12345
# The Key ID of the MusicKit (Media Services) key you created.
APPLE_KEY_ID=ABCDE67890
# Path to the .p8 private key file downloaded when you created the key.
APPLE_KEY_FILE=./secrets/AuthKey_ABCDE67890.p8

# Apple Music storefront to search/play from. Must match the Apple ID
# whose subscription/library you're using. "us" for a US subscription,
# "cn" for mainland China, etc. - see Apple's storefront ID list.
APPLE_STOREFRONT=us

# --- Data ---
# Where user_token.json, playlists.json, play_history.jsonl and
# history_state.json get written. Defaults to ./data if unset.
DATA_DIR=./data

# --- History playlist ---
# Name/description of the real Apple Music playlist this server
# auto-creates and appends every played song to.
HISTORY_PLAYLIST_NAME=Songs picked for you
HISTORY_PLAYLIST_DESC=Every song picked for you
